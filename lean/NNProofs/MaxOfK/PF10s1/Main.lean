other token is at least 1 below it, the transformer answers the maximum. -/
theorem correct3 (L : ℕ) (s : Fin (L + 1) → Fin M.V) (hm0 : 16 ≤ (seqMax s : ℕ))
    (hgap : ∀ i, s i = seqMax s ∨ (s i : ℕ) + 1 ≤ (seqMax s : ℕ)) (hN : others L s ≤ 3) :
    NetAnswers L s (seqMax s) :=
  gap_law bTab3 3 region3 1 16 gapOK3 L s hm0 hgap hN

theorem btOK3 : btOK bTab3 = true := by decide +kernel

theorem total3 : total 3 bTab3 = 16723558 := by decide +kernel

/-- **Accuracy at length 4**: at least 16723558 of the 64^4 inputs
(a fraction above 0.996801) are answered with their maximum. -/
