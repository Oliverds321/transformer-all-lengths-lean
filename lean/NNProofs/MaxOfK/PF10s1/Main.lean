/-- The failure table has an entry for exactly 56 maxima `m`, each with `n0 ≤ 36`. -/
theorem failCount : ((List.range 64).filter fun m => nFail m != 0).length = 56 := by
  decide +kernel

theorem failMax : (allTo 64 fun m => decide (nFail m ≤ 37)) = true := by decide +kernel

/-- The token 0 has no entry, so every counted maximum is covered by `failure` (which needs `0 < m`). -/
theorem failZero : nFail 0 = 0 := by decide +kernel

/-- For every maximum `m ≥ 16` (the least maximum of the first correctness statement)
the table has an entry, with `5 ≤ n0 ≤ 20`. -/
theorem failRange : (allTo 64 fun m =>
    decide (m < 16 ∨ (6 ≤ nFail m ∧ nFail m ≤ 21))) = true := by decide +kernel

theorem nFail_21 : nFail 21 = 6 := by decide +kernel

/-- **An explicit failure.** For every `n ≥ 5`, on the input "`n` copies of 20, then 21"
the transformer does not answer 21. -/
theorem failure_21 (n : ℕ) (hn : 5 ≤ n) :
    ¬ NetAnswers n (M.copies n ⟨20, by decide⟩ ⟨21, by decide⟩) ⟨21, by decide⟩ := by
  have h := failure 21 (by decide) (by decide) (by rw [nFail_21]; decide) n (by rw [nFail_21]; exact hn)
  exact h

theorem copies_seqMax (k : ℕ) (u m : Fin M.V) (h : u ≤ m) :
    seqMax (M.copies k u m) = m := by
  apply le_antisymm
  · unfold seqMax
    apply Finset.sup'_le
    intro i _
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · simp [IntPF.copies, h]
    · simp [IntPF.copies]
  · have := le_seqMax (M.copies k u m) (Fin.last k)
    simpa [IntPF.copies] using this

theorem others_copies_le (k : ℕ) (u m : Fin M.V) : others k (M.copies k u m) ≤ k := by
  unfold others
  exact (Finset.card_filter_le _ _).trans (by simp)

/-- **The same family, from the correct side.** For every `k ≤ 3`, on the input
"`k` copies of 20, then 21" the transformer answers 21 (an instance of `correct3`).
The theorem `threshold_21` below gives the exact range of `k`. -/
theorem correct_copies_21 (k : ℕ) (hk : k ≤ 3) :
    NetAnswers k (M.copies k ⟨20, by decide⟩ ⟨21, by decide⟩) ⟨21, by decide⟩ := by
  have hs : seqMax (M.copies k ⟨20, by decide⟩ ⟨21, by decide⟩) = ⟨21, by decide⟩ :=
    copies_seqMax k _ _ (by decide)
  have h := correct3 k (M.copies k ⟨20, by decide⟩ ⟨21, by decide⟩)
    (by rw [hs]; decide)
    (fun i => by
      rw [hs]
      rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
      · right; simp [IntPF.copies]
      · left; simp [IntPF.copies])
    ((others_copies_le k _ _).trans hk)
  rw [hs] at h
  exact h

/-- **Exact thresholds, correct side.** If `nTight m g = N + 1`, the transformer answers
`m` on every input, of any length, whose last token and maximum are `m`, whose other tokens
are at most `m - g`, and in which at most `N` positions before the last hold another token. -/
theorem threshold_correct (m g : ℕ) (hm : m < 64) (hg : g < 17) (hnt : nTight m g ≠ 0)
    (L : ℕ) (s : Fin (L + 1) → Fin M.V) (hq : (query s : ℕ) = m) (hmax : (seqMax s : ℕ) = m)
    (hgap : ∀ i, s i = seqMax s ∨ (s i : ℕ) + g ≤ m) (hN : others L s ≤ nTight m g - 1) :
    NetAnswers L s (seqMax s) := by
  rw [netAnswers_iff]
  exact M.tight_correct expOK nTight jTight m g (tight_all m g hm hg) hnt L s hq hmax hgap hN

/-- **Exact thresholds, failing side.** If `nTight m g = N + 1`, then for every `k > N` the
transformer does not answer `m` on `k` copies of `m - g` followed by `m`. -/
theorem threshold_fail (m g : ℕ) (hm : m < 64) (hg : g < 17) (hnt : nTight m g ≠ 0) (k : ℕ)
    (hk : nTight m g ≤ k) :
    ¬ NetAnswers k (M.copies k ⟨m - g, Nat.lt_of_le_of_lt (Nat.sub_le m g) hm⟩ ⟨m, hm⟩) ⟨m, hm⟩ := by
  rw [netAnswers_iff]
  exact M.tight_fail expOK nTight jTight m g hm (tight_all m g hm hg) hnt k hk

/-- **Exact thresholds.** If `nTight m g = N + 1`, then on `k` copies of `m - g` followed by
`m` the transformer answers `m` if and only if `k ≤ N`. -/
theorem threshold (m g : ℕ) (hm : m < 64) (hg : g < 17) (hnt : nTight m g ≠ 0) (k : ℕ) :
    NetAnswers k (M.copies k ⟨m - g, Nat.lt_of_le_of_lt (Nat.sub_le m g) hm⟩ ⟨m, hm⟩) ⟨m, hm⟩ ↔
      k < nTight m g := by
  constructor
  · intro h
    by_contra hk
    exact threshold_fail m g hm hg hnt k (Nat.le_of_not_lt hk) h
  · intro hk
    obtain ⟨-, h2, -⟩ := M.tightRow_spec nTight jTight m g (tight_all m g hm hg) hnt
    have hu : m - g < 64 := Nat.lt_of_le_of_lt (Nat.sub_le m g) hm
    have hs : seqMax (M.copies k ⟨m - g, hu⟩ ⟨m, hm⟩) = ⟨m, hm⟩ :=
      copies_seqMax k _ _ (Fin.mk_le_mk.mpr (Nat.sub_le m g))
    have hlast : M.copies k ⟨m - g, hu⟩ ⟨m, hm⟩ (Fin.last k) = ⟨m, hm⟩ := by
      unfold IntPF.copies
      exact Fin.snoc_last _ _
    have h := threshold_correct m g hm hg hnt k (M.copies k ⟨m - g, hu⟩ ⟨m, hm⟩)
      (by unfold query; rw [hlast])
      (by rw [hs])
      (fun i => by
        rw [hs]
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
        · right
          have e : M.copies k ⟨m - g, hu⟩ ⟨m, hm⟩ (Fin.castSucc j) = ⟨m - g, hu⟩ := by
            unfold IntPF.copies
            exact Fin.snoc_castSucc _ _ _
          rw [e]
          show m - g + g ≤ m
          omega
        · left; exact hlast)
      ((others_copies_le k _ _).trans (by omega))
    rw [hs] at h
    exact h

/-- The number of maxima `m ≥ 24` that have an exact threshold at the gap `g`. -/
def tightAt (g : ℕ) : ℕ :=
  ((List.range 64).filter fun m => decide (24 ≤ m) && nTight m g != 0).length

/-- Of the 40 maxima from 24 to 63, the number with an exact threshold, for the gaps 0 to 16
(no threshold is claimed at gap 0). -/
theorem tightCounts : (List.range 17).map tightAt = [0, 40, 40, 40, 40, 40, 40, 40, 40, 40, 38, 37, 35, 35, 34, 33, 32] := by decide +kernel

theorem nTight_21_1 : nTight 21 1 = 5 := by decide +kernel

/-- **An exact threshold.** On `k` copies of 20 followed by 21, the transformer answers
21 if and only if `k ≤ 4`. -/
theorem threshold_21 (k : ℕ) :
    NetAnswers k (M.copies k ⟨20, by decide⟩ ⟨21, by decide⟩) ⟨21, by decide⟩ ↔ k ≤ 4 := by
  have h := threshold 21 1 (by decide) (by decide) (by rw [nTight_21_1]; decide) k
  rw [nTight_21_1] at h
  exact h.trans Nat.lt_succ_iff

end NNProofs.MaxOfK.PF10s1
